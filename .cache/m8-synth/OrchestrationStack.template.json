  "ProvisioningStateMachine": {
   "Type": "AWS::StepFunctions::StateMachine",
   "Properties": {
    "DefinitionString": "{\"Comment\": \"spendctl M6 Standard provisioning workflow\", \"StartAt\": \"LaunchInstance\", \"States\": {\"LaunchInstance\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${ProvisionerArn}\", \"Payload\": {\"operation\": \"launch\", \"reservation_id.$\": \"$.reservation_id\", \"team.$\": \"$.team\", \"resource.$\": \"$.resource\", \"planned_hours.$\": \"$.planned_hours\", \"region.$\": \"$.region\", \"failure_injection.$\": \"$.failure_injection\"}}, \"ResultSelector\": {\"state.$\": \"$.Payload.state\", \"instance_id.$\": \"$.Payload.instance_id\", \"volume_ids.$\": \"$.Payload.volume_ids\"}, \"ResultPath\": \"$.launch\", \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"InitializeCleanupCount\"}], \"Next\": \"CheckLaunchResult\"}, \"CheckLaunchResult\": {\"Type\": \"Choice\", \"Choices\": [{\"Variable\": \"$.launch.state\", \"StringEquals\": \"INJECTED_PRELAUNCH_FAILURE\", \"Next\": \"ReleasePrelaunchFailure\"}], \"Default\": \"RecordResources\"}, \"RecordResources\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${RecordResourcesArn}\", \"Payload\": {\"reservation_id.$\": \"$.reservation_id\", \"instance_id.$\": \"$.launch.instance_id\", \"volume_ids.$\": \"$.launch.volume_ids\", \"execution_arn.$\": \"$$.Execution.Id\", \"launched_at.$\": \"$$.State.EnteredTime\"}}, \"ResultPath\": \"$.recorded_resources\", \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"InitializeCleanupCount\"}], \"Next\": \"InitializePollCount\"}, \"InitializePollCount\": {\"Type\": \"Pass\", \"Result\": {\"attempt\": 0}, \"ResultPath\": \"$.poll_counter\", \"Next\": \"PollInstance\"}, \"PollInstance\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${ProvisionerArn}\", \"Payload\": {\"operation\": \"poll\", \"reservation_id.$\": \"$.reservation_id\", \"team.$\": \"$.team\", \"instance_id.$\": \"$.launch.instance_id\", \"region.$\": \"$.region\"}}, \"ResultSelector\": {\"state.$\": \"$.Payload.state\", \"running.$\": \"$.Payload.running\"}, \"ResultPath\": \"$.poll\", \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"InitializeCleanupCount\"}], \"Next\": \"CheckPollResult\"}, \"CheckPollResult\": {\"Type\": \"Choice\", \"Choices\": [{\"Variable\": \"$.poll.running\", \"BooleanEquals\": true, \"Next\": \"ActivateReservation\"}, {\"Variable\": \"$.poll.state\", \"StringEquals\": \"terminated\", \"Next\": \"InitializeCleanupCount\"}, {\"Variable\": \"$.poll.state\", \"StringEquals\": \"stopped\", \"Next\": \"InitializeCleanupCount\"}, {\"Variable\": \"$.poll_counter.attempt\", \"NumericGreaterThanEquals\": 36, \"Next\": \"InitializeCleanupCount\"}], \"Default\": \"WaitBeforePoll\"}, \"WaitBeforePoll\": {\"Type\": \"Wait\", \"Seconds\": 10, \"Next\": \"IncrementPollCount\"}, \"IncrementPollCount\": {\"Type\": \"Pass\", \"Parameters\": {\"attempt.$\": \"States.MathAdd($.poll_counter.attempt, 1)\"}, \"ResultPath\": \"$.poll_counter\", \"Next\": \"PollInstance\"}, \"ActivateReservation\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${ActivateArn}\", \"Payload\": {\"reservation_id.$\": \"$.reservation_id\", \"instance_id.$\": \"$.launch.instance_id\", \"volume_ids.$\": \"$.launch.volume_ids\", \"execution_arn.$\": \"$$.Execution.Id\", \"launched_at.$\": \"$$.State.EnteredTime\"}}, \"ResultPath\": \"$.activation\", \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"InitializeCleanupCount\"}], \"Next\": \"RecordSuccess\"}, \"RecordSuccess\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${RecordOutcomeArn}\", \"Payload\": {\"reservation_id.$\": \"$.reservation_id\", \"execution_status\": \"SUCCEEDED\"}}, \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.status_failure\", \"Next\": \"RecordUnknownOutcome\"}], \"End\": true}, \"RecordUnknownOutcome\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${RecordOutcomeArn}\", \"Payload\": {\"reservation_id.$\": \"$.reservation_id\", \"execution_status\": \"UNKNOWN\"}}, \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"End\": true}, \"InitializeCleanupCount\": {\"Type\": \"Pass\", \"Result\": {\"attempt\": 0}, \"ResultPath\": \"$.cleanup_counter\", \"Next\": \"CleanupFailedLaunch\"}, \"CleanupFailedLaunch\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${ProvisionerArn}\", \"Payload\": {\"operation\": \"cleanup\", \"reservation_id.$\": \"$.reservation_id\", \"team.$\": \"$.team\", \"region.$\": \"$.region\"}}, \"ResultSelector\": {\"cleanup_state.$\": \"$.Payload.cleanup_state\", \"had_resources.$\": \"$.Payload.had_resources\"}, \"ResultPath\": \"$.cleanup\", \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.cleanup_failure\", \"Next\": \"RecordCleanupUnknown\"}], \"Next\": \"CheckCleanupResult\"}, \"CheckCleanupResult\": {\"Type\": \"Choice\", \"Choices\": [{\"Variable\": \"$.cleanup.cleanup_state\", \"StringEquals\": \"COMPLETE\", \"Next\": \"RecordFailure\"}, {\"Variable\": \"$.cleanup_counter.attempt\", \"NumericGreaterThanEquals\": 36, \"Next\": \"RecordCleanupUnknown\"}], \"Default\": \"WaitBeforeCleanupPoll\"}, \"WaitBeforeCleanupPoll\": {\"Type\": \"Wait\", \"Seconds\": 10, \"Next\": \"IncrementCleanupCount\"}, \"IncrementCleanupCount\": {\"Type\": \"Pass\", \"Parameters\": {\"attempt.$\": \"States.MathAdd($.cleanup_counter.attempt, 1)\"}, \"ResultPath\": \"$.cleanup_counter\", \"Next\": \"CleanupFailedLaunch\"}, \"RecordFailure\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${RecordOutcomeArn}\", \"Payload\": {\"reservation_id.$\": \"$.reservation_id\", \"execution_status\": \"FAILED\", \"cleanup_state.$\": \"$.cleanup.cleanup_state\", \"had_resources.$\": \"$.cleanup.had_resources\"}}, \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Next\": \"ProvisioningFailed\"}, \"RecordCleanupUnknown\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${RecordOutcomeArn}\", \"Payload\": {\"reservation_id.$\": \"$.reservation_id\", \"execution_status\": \"UNKNOWN\", \"cleanup_state\": \"UNKNOWN\"}}, \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Next\": \"ProvisioningFailed\"}, \"ReleasePrelaunchFailure\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::lambda:invoke\", \"Parameters\": {\"FunctionName\": \"${ReleasePrelaunchArn}\", \"Payload\": {\"reservation_id.$\": \"$.reservation_id\"}}, \"Retry\": [{\"ErrorEquals\": [\"Lambda.ServiceException\", \"Lambda.AWSLambdaException\", \"Lambda.SdkClientException\", \"Lambda.TooManyRequestsException\"], \"IntervalSeconds\": 2, \"MaxAttempts\": 4, \"BackoffRate\": 2.0}], \"Next\": \"InjectedFailure\"}, \"ProvisioningFailed\": {\"Type\": \"Fail\", \"Error\": \"ProvisioningFailed\", \"Cause\": \"Provisioning failed or cleanup requires reconciliation\"}, \"InjectedFailure\": {\"Type\": \"Fail\", \"Error\": \"InjectedProvisioningFailure\", \"Cause\": \"Pre-launch failure injection; reservation safely released\"}}}",
